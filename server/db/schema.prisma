// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

// 用户账号。档案、会话、衣橱直接挂在 User 上。
model User {
  id                  String       @id @default(cuid())
  username            String       @unique // 存小写
  passwordHash        String // scrypt:N:r:p:salt:hash (base64)
  securityQuestions   Json         @default("[]") // [{question, answerHash}]
  recoveryCodeHashes  String[]     @default([])
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  sessionVersion      Int          @default(0)
  /// 探索次数余额（缓存；以 CreditLedger 为准）
  creditBalance       Int          @default(0)
  /// 身高、风格、视觉分析等档案 JSON
  profileData         Json         @default("{}")
  conversations       Conversation[]
  clothingItems       ClothingItem[]
  savedOutfits        SavedOutfit[]
  creditLedger        CreditLedger[]
  usageEvents         UsageEvent[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// 积分流水：赠送 / 兑换 / 出图扣次 / 后台加额
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  /// signup_grant | redeem | admin_grant | image_gen | refund
  reason    String
  messageId String?
  imageId   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CreditRedeemCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  credits   Int
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  note      String?
  createdAt DateTime  @default(now())
}

/// 单次模型调用花费（与 usage-audit.jsonl 对齐，供跑数）
model UsageEvent {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId         String?
  conversationId   String?
  messageId        String?
  model            String
  /// chat | image | embedding
  kind             String
  cacheHitTokens   Int      @default(0)
  cacheMissTokens  Int      @default(0)
  completionTokens Int      @default(0)
  embeddingTokens  Int      @default(0)
  generatedImages  Int      @default(0)
  costCny          Decimal? @db.Decimal(12, 6)
  rateId           String
  createdAt        DateTime @default(now())

  @@index([messageId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// 一条 AI 消息的花费汇总
model UsageMessageRollup {
  messageId        String   @id
  userId           String?
  conversationId   String?
  calls            Int      @default(0)
  cacheHitTokens   Int      @default(0)
  cacheMissTokens  Int      @default(0)
  completionTokens Int      @default(0)
  embeddingTokens  Int      @default(0)
  generatedImages  Int      @default(0)
  pricedCostCny    Decimal  @default(0) @db.Decimal(12, 6)
  unpricedCalls    Int      @default(0)
  durationMs       Int?
  updatedAt        DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// 用户收藏的穿搭方案快照（归属 userId；托管模式可按 eligibleForPlan 抽取）
model SavedOutfit {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceMessageId      String?
  sourceConversationId String?
  sourceOutfitId       String

  title           String
  coverImageUrl   String?
  /// { concept, items: [{ wardrobeItemId?, name, layer, imageUrl? }], visual? }
  snapshot        Json

  eligibleForPlan Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, sourceMessageId, sourceOutfitId])
  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  summaries Summary[]
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  role           String // "user" or "ai"
  content        Json         @default("{}") // 使用 Json 类型来存储复杂的 content 结构
  status         String       @default("completed") // "generating", "completed", "failed"
  timestamp      DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
}

// --- [新增] --- 全新的 Summary 模型
model Summary {
  id              String    @id @default(cuid())
  content         String    @db.Text
  createdAt       DateTime  @default(now())
  
  // 记录这个摘要涵盖了此时间戳之前的所有消息
  summarizedUntil DateTime  

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// --- [新增] --- 橱窗功能模型
// 1. 定义衣物主类别枚举
enum ClothingMainCategory {
  TOP       // 上装
  BOTTOM    // 下装
  OUTERWEAR // 外套
  FOOTWEAR  // 鞋履
  ACCESSORY // 配饰
  ONE_PIECE // 连身装 (如连衣裙、连体裤)
}

// 2. 定义衣物单品模型
model ClothingItem {
  id           String               @id @default(cuid())
  imageUrl     String
  mainCategory ClothingMainCategory // 主要类别 (用于 Tab 分类)
  subCategory  String               // 子类别 (AI 自动生成, e.g., 'T-shirt', 'Jeans')
  season       String[]             @default([]) // 新增：季节
  material     String[]             @default([]) // 新增：材质
  /// 合适穿着的温度下限（摄氏度，含边界）。空表示不设下限
  tempMin      Int?
  /// 合适穿着的温度上限（摄氏度，含边界）。空表示不设上限
  tempMax      Int?
  description         String?
  colors                String[]
  tags                  String[]
  /// 检索导向：面向 embedding 的英文描述（场合 + 搭配语境）
  searchDescription     String?
  occasions             String[]             @default([])
  formality             String?
  silhouette            String[]             @default([])
  /// 图文混合向量 — 图搜图 / 以图搜相似款；不参与 Stylist 文本 RAG
  embedding             Unsupported("vector(2048)")?
  /// 纯文本检索向量 — Stylist / Gatekeeper 文本 RAG
  textEmbedding         Unsupported("vector(2048)")?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt


  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


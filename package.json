{
  "name": "ootd-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && NODE_OPTIONS='--max-old-space-size=8192'  next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "next start",
    "lint": "eslint && tsc --noEmit",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:prompts": "tsx --test \"tests/prompts/**/*.test.ts\"",
    "test:e2e": "playwright test --project=mock",
    "test:e2e:live": "dotenv -e .env -e .env.local -- env PW_LIVE=1 playwright test --project=live",
    "test:e2e:all": "pnpm test:e2e && pnpm test:e2e:live",
    "replay:rag-scores": "dotenv -e .env -e .env.local -- tsx scripts/replay-rag-search-scores.ts",
    "reindex:wardrobe-embeddings": "dotenv -e .env -e .env.local -- tsx scripts/reindex-wardrobe-embeddings.ts",
    "reindex:wardrobe-text": "dotenv -e .env -e .env.local -- tsx scripts/reindex-wardrobe-text-embeddings.ts",
    "diagnose:embedding-scores": "dotenv -e .env -e .env.local -- tsx scripts/diagnose-embedding-scores.ts",
    "db:migrate": "dotenv -e .env -e .env.local -- npx prisma migrate dev --schema=server/db/schema.prisma",
    "db:migrate:deploy": "dotenv -e .env -e .env.local -- npx prisma migrate deploy --schema=server/db/schema.prisma",
    "db:migrate:neon": "dotenv -e .env -e .env.local -- tsx scripts/neon-migrate-deploy.ts",
    "db:generate": "pnpm npx prisma generate --schema=./server/db/schema.prisma",
    "db:push": "dotenv -- prisma db push",
    "db:data": "pnpm prisma studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/node-fetch": "2",
    "@types/uuid": "^11.0.0",
    "async-retry": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.4.2",
    "global-agent": "^4.1.3",
    "google-auth-library": "^10.6.2",
    "https-proxy-agent": "^9.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "node-fetch": "2",
    "openai": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.3.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.1.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/async-retry": "^1.4.9",
    "@types/global-agent": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'tsc -p tsconfig.json --noEmit'"
    ]
  }
}
    "@types/uuid": "^11.0.0",
    "async-retry": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "global-agent": "^4.1.3",
    "https-proxy-agent": "^9.0.0",
    "idb": "^8.0.3",

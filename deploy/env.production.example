# 复制为项目根目录 .env 后填写真实值（勿提交）
# cp deploy/.env.production.example .env && chmod 600 .env

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# --- Single-user access ---
OWNER_CLIENT_ID=
NEXT_PUBLIC_OWNER_CLIENT_ID=
ACCESS_CODE=
ACCESS_SESSION_SECRET=

# --- Tencent COS ---
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-nanjing
COS_KEY_PREFIX=shows/
COS_PUBLIC_BASE_URL=

# --- LLM (OpenAI-compatible default) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1
LLM_VENDOR=kimi

# --- Image generation ---
IMAGE_VENDOR=ark
ARK_API_KEY=

# --- Embeddings ---
EMBEDDING_VENDOR=bytedance

# --- Weather (Gaode / 高德) ---
AMAP_WEB_SERVICE_KEY=

# --- LangSmith (optional; view LangGraph runs at smith.langchain.com) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ootd-agent
# Next.js / serverless: flush traces before the request ends
LANGCHAIN_CALLBACKS_BACKGROUND=false

# --- Runtime ---
NODE_ENV=production
